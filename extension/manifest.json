{
  "manifest_version": 3,
  "name": "Live Audio Enhancer",
  "version": "0.21.0",
  "description": "配信の音を聞きやすくします。AIノイズキャンセル、音量をそろえる、イコライザー（オート）",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Live Audio Enhancer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.nicovideo.jp/*",
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://www.twitch.tv/*",
        "https://tver.jp/*",
        "https://abema.tv/*"
      ],
      "js": ["shared/settings.js", "audio/auto-eq.js", "audio/speech-judge.js", "audio/audio-graph.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*"],
      "matches": [
        "https://live.nicovideo.jp/*",
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://www.twitch.tv/*",
        "https://tver.jp/*",
        "https://abema.tv/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
