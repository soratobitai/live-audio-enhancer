{
  "manifest_version": 3,
  "name": "Audio FX",
  "version": "0.2.0",
  "description": "ライブ配信の音声にイコライザーをかける",
  "permissions": ["storage"],
  "action": {
    "default_title": "Audio FX",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.nicovideo.jp/*",
        "https://www.youtube.com/*"
      ],
      "js": ["shared/settings.js", "audio/audio-graph.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
